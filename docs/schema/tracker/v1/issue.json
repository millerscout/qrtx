{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/millerscout/sdd/docs/schema/tracker/v1/issue.json",
  "title": "sdd tracker issue (sdd.adapter/v1)",
  "type": "object",
  "required": ["id", "title", "status"],
  "additionalProperties": true,
  "properties": {
    "id": {"type": "string", "minLength": 1, "description": "Backend-native, opaque: \"123\", \"PROJ-42\", \"sdd-k3f9qa\"."},
    "url": {"type": "string"},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string", "description": "Markdown."},
    "status": {
      "type": "object",
      "required": ["category"],
      "properties": {
        "name": {"type": "string", "description": "Native status, e.g. \"In Review\"."},
        "category": {"enum": ["backlog", "unstarted", "started", "completed", "canceled"]}
      }
    },
    "type": {"type": "string", "description": "Native type: Story, Bug, Epic…"},
    "priority": {"type": "integer", "minimum": 0, "maximum": 4, "description": "0 none, 1 urgent … 4 low."},
    "labels": {"type": "array", "items": {"type": "string"}},
    "assignee": {"type": "string"},
    "parent": {"type": "string"},
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "id"],
        "properties": {
          "type": {"enum": ["blocks", "relates", "duplicates"]},
          "id": {"type": "string"}
        }
      }
    },
    "updated_at": {"type": "string", "format": "date-time"},
    "extra": {"type": "object", "description": "Backend fields. Round-tripped unchanged."},
    "client_ref": {"type": "string", "description": "Idempotency key of the create that made this issue."},
    "sdd": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["repo"],
        "properties": {
          "repo": {"type": "string"},
          "project": {"type": "string"},
          "change": {"type": "string"},
          "role": {"enum": ["", "deferred"]},
          "phase": {"type": "string"},
          "tasks": {"type": "array", "items": {"type": "string"}},
          "scenarios": {"type": "array", "items": {"type": "string"}},
          "branch": {"type": "string"},
          "commit": {"type": "string"}
        }
      }
    }
  }
}
